# ═══════════════════════════════════════════════════════════════════
# DBX — Docker Compose Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and adjust values before running:
#   cp .env.example .env
#   docker compose up -d
# ═══════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────
# For the all-in-one compose (docker-compose.yml):
POSTGRES_USER=dbx
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=dbx

# For docker-compose.external-postgres.yml, set the existing DB URL instead:
# DBX_DATABASE_URL=postgresql://postgres:xmsme@123@postgres:5432/dbx
# SONAR_NETWORK_NAME=sonar

# ── OpenLDAP ──────────────────────────────────────────────────────
LDAP_ORGANISATION=DBX
LDAP_DOMAIN=example.com
LDAP_ADMIN_PASSWORD=changeme_ldap
LDAP_CONFIG_PASSWORD=changeme_ldap_config

# ── DBX Application ───────────────────────────────────────────────
DBX_DATABASE_URL=postgresql://dbx:changeme_postgres@postgres:5432/dbx

# ── LDAP Authentication ───────────────────────────────────────────
# Set to "true" to enable LDAP login. When enabled, DBX authenticates
# users against the LDAP server before falling back to local auth.
DBX_LDAP_ENABLED=false

DBX_LDAP_URL=ldap://ldap:389
DBX_LDAP_BIND_DN=cn=admin,dc=example,dc=com
DBX_LDAP_BIND_PASSWORD=changeme_ldap
DBX_LDAP_BASE_DN=dc=example,dc=com
DBX_LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=com
DBX_LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=com
DBX_LDAP_USER_FILTER=(uid=%s)

# LDAP TLS — mount a CA cert to the container and set these:
# DBX_LDAP_TLS_ENABLED=true
# DBX_LDAP_TLS_INSECURE=false
DBX_LDAP_TLS_ENABLED=false
DBX_LDAP_TLS_INSECURE=false

# ── Local Auth Fallback ───────────────────────────────────────────
# The admin password used when LDAP is disabled or as a fallback.
# On first login, this password is hashed with Argon2 and stored.
DBX_PASSWORD=changeme

# JWT secret for session tokens (minimum 32 characters)
DBX_JWT_SECRET=change_this_to_a_secure_random_string_min_32_chars

# ── Server ────────────────────────────────────────────────────────
DBX_PORT=4224
DBX_STATIC_DIR=/app/static
DBX_DATA_DIR=/app/data
DBX_MAX_UPLOAD_MB=1024
